{
  "world": "./conf/maps/soccer_field_mini.world",
  "robots": [
    {
      "name": "QUAKY2-1",
      "linda": {
        "address": "localhost",
        "port": 3000,
        "instantiate": true
      },
      "modules": [
        {
          "name": "Controller",
          "properties": {
            "CLASS": "tcrob.umu.quaky2.SoccerController",
            "GFX": "true",
            "MODE": "shared",
            "PASSIVE": "true",
            "PRG": "./conf/programs/bg/quaky2.soccer.b",
            "TYPE": "Controller",
            "AUTO": "true"
          },
          "events": [
            {
              "symbol": "LPS",
              "itemClass": "tc.shared.linda.ItemLPS",
              "method": "notify_lps"
            },
            {
              "symbol": "GOAL",
              "itemClass": "tc.shared.linda.ItemGoal",
              "method": "notify_goal"
            }
          ]
        },
        {
          "name": "Planner",
          "properties": {
            "CLASS": "tcrob.umu.quaky2.SoccerPlanner",
            "EXTIME": "1000",
            "GFX": "true",
            "MODE": "shared",
            "PASSIVE": "false",
            "POLLED": "true",
            "QUEUED": "false",
            "TYPE": "Planner"
          },
          "events": [
            {
              "symbol": "PLAN",
              "itemClass": "tc.shared.linda.ItemPlan",
              "method": "notify_plan"
            },
            {
              "symbol": "BEHRESULT",
              "itemClass": "tc.shared.linda.ItemBehResult",
              "method": "notify_beh_result"
            }
          ]
        },
        {
          "name": "Perception",
          "properties": {
            "CLASS": "tcrob.umu.indoor.IndoorPerception",
            "MODE": "shared",
            "PASSIVE": "true",
            "TYPE": "Perception",
            "GFX": "true"
          },
          "events": [
            {
              "symbol": "SENSORS",
              "itemClass": "tc.shared.linda.ItemSensors",
              "method": "notify_sensors"
            },
            {
              "symbol": "NAVIGATION",
              "itemClass": "tc.shared.linda.ItemNavigation",
              "method": "notify_navigation"
            }
          ]
        },
        {
          "name": "Vision",
          "properties": {
            "TYPE": "Perception",
            "MODE": "shared",
            "PASSIVE": "true",
            "GFX": "true",
            "CLASS": "tcrob.umu.quaky2.SoccerVision",
            "PARAMS": "./conf/vision/quaky2-soccer.chaos"
          },
          "events": [
            {
              "symbol": "CAMERA",
              "itemClass": "tc.shared.linda.ItemCamera",
              "method": "notify_camera"
            }
          ]
        }
      ],
      "virtualRobot": {
        "name": "Virtual Robot",
        "properties": {
          "CLASS": "tcrob.umu.quaky2.Quaky2",
          "DESC": "./conf/robots/quaky2.robot",
          "EXTIME": "75",
          "GFX": "true",
          "MODE": "shared",
          "PASSIVE": "false"
        },
        "events": [
          {
            "symbol": "MOTION",
            "itemClass": "tc.shared.linda.ItemMotion",
            "method": "notify_motion"
          }
        ]
      },
      "properties": {}
    }
  ]
}

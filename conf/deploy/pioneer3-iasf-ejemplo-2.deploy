{
  "world": "conf/maps/iasf_ejemplo_2.world",
  "robots": [
    {
      "name": "IASF-1",
      "linda": {
        "address": "localhost",
        "port": 3000,
        "instantiate": true
      },
      "modules": [
        {
          "name": "Navigation",
          "properties": {
            "CLASS": "tcrob.umu.indoor.IndoorNavigation",
            "GFX": "true",
            "MODE": "shared",
            "PASSIVE": "true",
            "POLLED": "false",
            "QUEUED": "false"
          },
          "events": [
            {
              "symbol": "LPS",
              "itemClass": "tc.shared.linda.ItemLPS",
              "method": "notify_lps"
            },
            {
              "symbol": "GOAL",
              "itemClass": "tc.shared.linda.ItemGoal",
              "method": "notify_goal"
            }
          ]
        },
        {
          "name": "Controller",
          "properties": {
            "CLASS": "tclib.behaviours.bg.BGController",
            "GFX": "true",
            "MODE": "shared",
            "PASSIVE": "true",
            "PRG": "conf/programs/iasf-ejemplo-2.b"
          },
          "events": [
            {
              "symbol": "LPS",
              "itemClass": "tc.shared.linda.ItemLPS",
              "method": "notify_lps"
            },
            {
              "symbol": "GOAL",
              "itemClass": "tc.shared.linda.ItemGoal",
              "method": "notify_goal"
            },
            {
              "symbol": "PATH",
              "itemClass": "tc.shared.linda.ItemPath",
              "method": "notify_path"
            }
          ]
        },
        {
          "name": "Planner",
          "properties": {
            "CLASS": "tclib.planning.sequence.SeqPlanner",
            "EXTIME": "1000",
            "GFX": "true",
            "MODE": "shared",
            "PASSIVE": "false",
            "POLLED": "true",
            "QUEUED": "false"
          },
          "events": [
            {
              "symbol": "PLAN",
              "itemClass": "tc.shared.linda.ItemPlan",
              "method": "notify_plan"
            },
            {
              "symbol": "BEHRESULT",
              "itemClass": "tc.shared.linda.ItemBehResult",
              "method": "notify_beh_result"
            }
          ]
        },
        {
          "name": "Perception",
          "properties": {
            "CLASS": "tcrob.umu.indoor.IndoorPerception",
            "GFX": "true",
            "MODE": "shared",
            "PASSIVE": "true"
          },
          "events": [
            {
              "symbol": "DATA",
              "itemClass": "tc.shared.linda.ItemData",
              "method": "notify_data"
            },
            {
              "symbol": "OBJECT",
              "itemClass": "tc.shared.linda.ItemObject",
              "method": "notify_object"
            },
            {
              "symbol": "NAVIGATION",
              "itemClass": "tc.shared.linda.ItemNavigation",
              "method": "notify_navigation"
            }
          ]
        }
      ],
      "virtualRobot": {
        "name": "Virtual Robot",
        "properties": {
          "CLASS": "tcrob.umu.pioneer3.Pioneer3",
          "DESC": "conf/robots/pioneer3.robot",
          "EXTIME": "100",
          "GFX": "false",
          "MODE": "shared",
          "PASSIVE": "false",
          "WORLD": "conf/maps/um_diic_small.world"
        },
        "events": [
          {
            "symbol": "MOTION",
            "itemClass": "tc.shared.linda.ItemMotion",
            "method": "notify_motion"
          },
          {
            "symbol": "DATACTRL",
            "itemClass": "tc.shared.linda.ItemDataCtrl",
            "method": "notify_data_ctrl"
          }
        ]
      },
      "properties": {}
    }
  ]
}

{
  "world": "./conf/maps/aass_corr.world",
  "robots": [
    {
      "name": "B21",
      "linda": {
        "address": "localhost",
        "port": 3000,
        "instantiate": true
      },
      "modules": [
        {
          "name": "Navigation",
          "properties": {
            "CLASS": "tcrob.umu.indoor.IndoorNavigation",
            "GFX": "true",
            "MODE": "shared",
            "PASSIVE": "true",
            "POLLED": "false",
            "QUEUED": "false",
            "TYPE": "Navigation"
          },
          "events": [
            {
              "symbol": "LPS",
              "itemClass": "tc.shared.linda.ItemLPS",
              "method": "notify_lps"
            },
            {
              "symbol": "GOAL",
              "itemClass": "tc.shared.linda.ItemGoal",
              "method": "notify_goal"
            }
          ]
        },
        {
          "name": "Controller",
          "properties": {
            "BEH": "MainBehaviour",
            "CLASS": "tclib.behaviours.fhb.FHBController",
            "FACT": "tcrob.umu.indoor.behs, ./sources/tcrob/umu/indoor/behs/, ./runtime",
            "GFX": "true",
            "MODE": "shared",
            "PASSIVE": "true",
            "TYPE": "Controller"
          },
          "events": [
            {
              "symbol": "LPS",
              "itemClass": "tc.shared.linda.ItemLPS",
              "method": "notify_lps"
            },
            {
              "symbol": "GOAL",
              "itemClass": "tc.shared.linda.ItemGoal",
              "method": "notify_goal"
            },
            {
              "symbol": "PATH",
              "itemClass": "tc.shared.linda.ItemPath",
              "method": "notify_path"
            },
            {
              "symbol": "BEHNAME",
              "itemClass": "tc.shared.linda.ItemBehName",
              "method": "notify_beh_name"
            },
            {
              "symbol": "BEHRULES",
              "itemClass": "tc.shared.linda.ItemBehRules",
              "method": "notify_beh_rules"
            },
            {
              "symbol": "BEHDEBUG",
              "itemClass": "tc.shared.linda.ItemBehDebug",
              "method": "notify_beh_debug"
            }
          ]
        },
        {
          "name": "Planner",
          "properties": {
            "CLASS": "tclib.planning.sequence.SeqPlanner",
            "EXTIME": "1000",
            "GFX": "true",
            "MODE": "shared",
            "PASSIVE": "false",
            "POLLED": "true",
            "QUEUED": "false",
            "TYPE": "Planner"
          },
          "events": [
            {
              "symbol": "PLAN",
              "itemClass": "tc.shared.linda.ItemPlan",
              "method": "notify_plan"
            },
            {
              "symbol": "BEHRESULT",
              "itemClass": "tc.shared.linda.ItemBehResult",
              "method": "notify_beh_result"
            }
          ]
        },
        {
          "name": "Perception",
          "properties": {
            "CLASS": "tcrob.umu.indoor.IndoorPerception",
            "GFX": "true",
            "MODE": "shared",
            "PASSIVE": "true",
            "TYPE": "Perception"
          },
          "events": [
            {
              "symbol": "DATA",
              "itemClass": "tc.shared.linda.ItemData",
              "method": "notify_data"
            },
            {
              "symbol": "OBJECT",
              "itemClass": "tc.shared.linda.ItemObject",
              "method": "notify_object"
            },
            {
              "symbol": "NAVIGATION",
              "itemClass": "tc.shared.linda.ItemNavigation",
              "method": "notify_navigation"
            }
          ]
        }
      ],
      "virtualRobot": {
        "name": "Virtual Robot",
        "properties": {
          "DESC": "./conf/robots/b21.robot",
          "EXTIME": "175",
          "GFX": "true",
          "MODE": "shared",
          "PASSIVE": "false"
        },
        "events": [
          {
            "symbol": "MOTION",
            "itemClass": "tc.shared.linda.ItemMotion",
            "method": "notify_motion"
          },
          {
            "symbol": "DATACTRL",
            "itemClass": "tc.shared.linda.ItemDataCtrl",
            "method": "notify_data_ctrl"
          }
        ]
      },
      "properties": {}
    }
  ]
}

{
  "world": "./conf/maps/soccer_field_aibo_2007_2robots.world",
  "globalLinda": {
    "address": "localhost",
    "port": 5500,
    "instantiate": true
  },
  "robots": [
    {
      "name": "BLUE-1",
      "linda": {
        "address": "localhost",
        "port": 3000,
        "instantiate": true
      },
      "router": {
        "name": "Linda Router",
        "properties": {
          "CLASS": "tcrob.umu.soccer.SoccerLindaRouter",
          "MODE": "shared",
          "GMODE": "tcp",
          "GFX": "false"
        },
        "events": []
      },
      "modules": [
        {
          "name": "Controller",
          "properties": {
            "CLASS": "tcrob.umu.soccer.SoccerHfsmController",
            "GFX": "false",
            "MODE": "shared",
            "PASSIVE": "true",
            "PRG": "./conf/programs/hfsm/match_attacker.hfsm",
            "TYPE": "Controller",
            "AUTO": "true",
            "POLLED": "false",
            "QUEUED": "false"
          },
          "events": [
            {
              "symbol": "LPS",
              "itemClass": "tc.shared.linda.ItemLPS",
              "method": "notify_lps"
            },
            {
              "symbol": "REFEREE",
              "itemClass": "tcrob.umu.soccer.linda.ItemReferee",
              "method": "notify_referee"
            },
            {
              "symbol": "NAVIGATION",
              "itemClass": "tc.shared.linda.ItemNavigation",
              "method": "notify_navigation"
            }
          ]
        },
        {
          "name": "Perception",
          "properties": {
            "CLASS": "tcrob.umu.indoor.IndoorPerception",
            "MODE": "shared",
            "PASSIVE": "true",
            "TYPE": "Perception",
            "GFX": "false",
            "POLLED": "false",
            "QUEUED": "false"
          },
          "events": [
            {
              "symbol": "SENSORS",
              "itemClass": "tc.shared.linda.ItemSensors",
              "method": "notify_sensors"
            }
          ]
        },
        {
          "name": "Vision",
          "properties": {
            "TYPE": "Perception",
            "MODE": "shared",
            "PASSIVE": "true",
            "GFX": "false",
            "CLASS": "tcrob.umu.soccer.SoccerVision",
            "PARAMS": "./conf/vision/aibo-soccer-2007.chaos",
            "POLLED": "false",
            "QUEUED": "false"
          },
          "events": [
            {
              "symbol": "CAMERA",
              "itemClass": "tc.shared.linda.ItemCamera",
              "method": "notify_camera"
            },
            {
              "symbol": "BEH_NEEDS",
              "itemClass": "tc.shared.linda.ItemBehNeeds",
              "method": "notify_beh_neeeds"
            }
          ]
        },
        {
          "name": "Navigation",
          "properties": {
            "TYPE": "Navigation",
            "MODE": "shared",
            "PASSIVE": "true",
            "GFX": "false",
            "CLASS": "tcrob.umu.soccer.SoccerLocalization",
            "POLLED": "false",
            "QUEUED": "false"
          },
          "events": [
            {
              "symbol": "LPS",
              "itemClass": "tc.shared.linda.ItemLPS",
              "method": "notify_lps"
            }
          ]
        }
      ],
      "virtualRobot": {

{
  "world": "conf/maps/iasf_ejemplo_1.world",
  "robots": [
    {
      "name": "IASF-1",
      "linda": {
        "address": "localhost",
        "port": 3000,
        "instantiate": true
      },
      "modules": [
        {
          "name": "Controller",
          "properties": {
            "CLASS": "tclib.behaviours.bg.BGController",
            "GFX": "true",
            "MODE": "shared",
            "PASSIVE": "true",
            "PRG": "./conf/programs/iasf-ejemplo-1.b",
            "QUEUED": "true",
            "TYPE": "Controller",
            "AUTO": "true"
          },
          "events": [
            {
              "symbol": "LPS",
              "itemClass": "tc.shared.linda.ItemLPS",
              "method": "notify_lps"
            }
          ]
        },
        {
          "name": "Perception",
          "properties": {
            "CLASS": "tcrob.umu.indoor.IndoorPerception",
            "GFX": "true",
            "MODE": "shared",
            "PASSIVE": "true",
            "TYPE": "Perception"
          },
          "events": [
            {
              "symbol": "DATA",
              "itemClass": "tc.shared.linda.ItemData",
              "method": "notify_data"
            }
          ]
        }
      ],
      "virtualRobot": {
        "name": "Virtual Robot",
        "properties": {
          "CLASS": "tcrob.umu.pioneer3.Pioneer3",
          "DESC": "./conf/robots/pioneer3.robot",
          "EXTIME": "100",
          "GFX": "false",
          "MODE": "shared",
          "PASSIVE": "false"
        },
        "events": [
          {
            "symbol": "MOTION",
            "itemClass": "tc.shared.linda.ItemMotion",
            "method": "notify_motion"
          },
          {
            "symbol": "DATACTRL",
            "itemClass": "tc.shared.linda.ItemDataCtrl",
            "method": "notify_data_ctrl"
          }
        ]
      },
      "properties": {}
    }
  ]
}

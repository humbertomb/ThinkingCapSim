{
  "name": "match_attacker",
  "behpath": "./conf/programs/lua/aibo-soccer",
  "machine": {
    "name": "match_attacker",
    "id": 0,
    "x": 0,
    "y": 0,
    "meta": true,
    "initial": "Initial",
    "initialId": 1,
    "states": [
      {
        "name": "Initial",
        "id": 1,
        "x": -278,
        "y": -134,
        "transitions": [
          {
            "name": "RefereeReady",
            "id": 6,
            "x": -257,
            "y": -270,
            "to": "Ready",
            "toId": 2,
            "test": "local referee = chaos.getGameState ()\nif referee.state == chaos.REFEREE_READY then\n\treturn true\nend\nreturn false\n"
          },
          {
            "name": "RefereePlaying",
            "id": 13,
            "x": -178,
            "y": -88,
            "to": "Playing",
            "toId": 4,
            "test": "local referee = chaos.getGameState ()\nif referee.state == chaos.REFEREE_PLAYING then\n\treturn true\nend\nreturn false\n"
          }
        ]
      },
      {
        "name": "Ready",
        "id": 2,
        "x": -71,
        "y": -321,
        "transitions": [
          {
            "name": "RefereeSet",
            "id": 7,
            "x": 18,
            "y": -280,
            "to": "Set",
            "toId": 3,
            "test": "local referee = chaos.getGameState ()\nif referee.state == chaos.REFEREE_SET then\n\treturn true\nend\nreturn false\n"
          }
        ],
        "meta": true,
        "initial": "Localize",
        "initialId": 16,
        "states": [
          {
            "name": "GoToPos",
            "id": 15,
            "x": 164,
            "y": -45,
            "code": "local pos = chaos.getStartPos()\nchaos.setDesiredPos(pos.x, pos.y, 90)\nchaos.setScanType (chaos.SCAN_FULL)\nchaos.setBehavior(\"goToPos\")\n\n",
            "transitions": [
              {
                "name": "IAmLost",
                "id": 17,
                "x": -58,
                "y": -140,
                "to": "Localize",
                "toId": 16,
                "test": "local gs = chaos.getCurrentPos ()\nif gs.quality < 0.7 then\n\treturn true\nend\nreturn false"
              }
            ]
          },
          {
            "name": "Localize",
            "id": 16,
            "x": -182,
            "y": -44,
            "code": "local lm1 = chaos.getLpo (chaos.LANDMARK1_LPO)\nlocal lm2 = chaos.getLpo (chaos.LANDMARK2_LPO)\n\nchaos.setScanType (chaos.SCAN_FULL)\nif lm1.anchored < lm2.anchored then\n\tchaos.setBehavior (\"lookForLandmark1\")\nelse\n\tchaos.setBehavior (\"lookForLandmark2\")\nend",
            "transitions": [
              {
                "name": "IAmLocalized",
                "id": 18,
                "x": -58,
                "y": 27,
                "to": "GoToPos",
                "toId": 15,
                "test": "local gs = chaos.getCurrentPos ()\nif gs.quality >= 0.8 then\n\treturn true\nend\nreturn false"
              }
            ]
          }
        ]
      },
      {
        "name": "Set",
        "id": 3,
        "x": 157,
        "y": -144,
        "transitions": [
          {
            "name": "RefereePlaying",
            "id": 8,
            "x": 97,
            "y": -43,
            "to": "Playing",
            "toId": 4,
            "test": "local referee = chaos.getGameState ()\nif referee.state == chaos.REFEREE_PLAYING then\n\treturn true\nend\nreturn false\n"
          }
        ]
      },
      {
        "name": "Playing",
        "id": 4,
        "x": 29,
        "y": 60,
        "transitions": [
          {
            "name": "RefereeFinished",
            "id": 9,
            "x": -196,
            "y": 80,
            "to": "Finished",
            "toId": 5,
            "test": "local referee = chaos.getGameState ()\nif referee.state == chaos.REFEREE_FINISHED then\n\treturn true\nend\nreturn false\n"
          },
          {
            "name": "RefereePenalized",
            "id": 11,
            "x": 161,
            "y": 39,
            "to": "Penalized",
            "toId": 10,
            "test": "local referee = chaos.getGameState ()\nif referee.state == chaos.REFEREE_PENALIZED then\n\treturn true\nend\nreturn false\n"
          },
          {
            "name": "RefereeReady",
            "id": 14,
            "x": -41,
            "y": -166,
            "to": "Ready",
            "toId": 2,
            "test": "local referee = chaos.getGameState ()\nif referee.state == chaos.REFEREE_READY then\n\treturn true\nend\nreturn false\n"
          }
        ],
        "meta": true,
        "extern": true,
        "path": "./conf/programs/hfsm/attacker.hfsm",
        "states": []
      },
      {
        "name": "Finished",
        "id": 5,
        "x": -272,
        "y": 6
      },
      {
        "name": "Penalized",
        "id": 10,
        "x": 377,
        "y": 110,
        "code": "chaos.setNeeded (chaos.BALL_LPO, 1.0)\nchaos.setNeeded (chaos.NET1_LPO, 0.7)\nchaos.setScanType (chaos.SCAN_FULL)\nchaos.setVelocities (0, 0, 0)",
        "transitions": [
          {
            "name": "RefereeCleared",
            "id": 12,
            "x": 148,
            "y": 145,
            "to": "Playing",
            "toId": 4,
            "test": "local referee = chaos.getGameState ()\nif referee.state == chaos.REFEREE_PLAYING then\n\treturn true\nend\nreturn false\n"
          }
        ]
      }
    ]
  }
}

temp=chaos.gsGetMyPos()
initialPos=chaos.getDesiredPos()
dx=initialPos.x - temp.x
dy=initialPos.y - temp.y
dist=math.sqrt(dx*dx + dy*dy)

ball=chaos.getLpo(0) -- Ball

if temp.quality > QUALITY_HIGH and dist < OUT_POS and 
   ball.anchored > ANCHORED_HIGH and ball.rho < BALL_IN_AREA then
    return true
else
    return false
end
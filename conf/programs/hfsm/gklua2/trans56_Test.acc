PI2=3.141592/2.0
temp=chaos.gsGetMyPos()
initialPos=chaos.getDesiredPos()
dx=initialPos.x - temp.x
dy=initialPos.y - temp.y
dist=math.sqrt(dx*dx + dy*dy)
net1=chaos.getLpo(3) -- Net1

-- InPos and (see net1 or myPos.angle is 90)

--if dist < IN_POS and ((net1.anchored > ANCHORED_HIGH and math.abs( net1.theta ) < ANG_LOW) or
--                     (math.abs(temp.theta-PI2) < ANG_LOW and temp.quality > QUALITY_HIGH)) then
if dist < IN_POS and (net1.anchored > ANCHORED_HIGH and math.abs( net1.theta ) < ANG_LOW) then
    return true
else
    return false

end

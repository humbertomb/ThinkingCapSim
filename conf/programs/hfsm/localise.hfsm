    "states": [
      {
        "name": "Position1",
        "id": 1,
        "x": 52,
        "y": 65,
        "code": "chaos.setDesiredPos(POS1X, POS1Y, 0)\nchaos.setBehavior(\"go2gpos\")",
        "transitions": [
          {
            "name": "InPosition1",
            "id": 2,
            "x": 418,
            "y": 33,
            "to": "Position2",
            "toId": 3,
            "test": "-- Geometrical computations\nlocal pos = chaos.gsGetMyPos()\n\ndx = POS1X - pos.x\ndy = POS1Y - pos.y\nrho= math.sqrt(dx*dx+dy*dy)\n\nif (rho < THRES) and (pos.quality > QPOS) then\n\treturn true\nelse\n\treturn false\nend\n",
            "action": "chaos.setSynchroKick(\"HappyKick\")\n"

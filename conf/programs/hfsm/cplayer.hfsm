                "toId": 5,
                "test": "KICK_DONE = chaos.getGlobal(\"KICK_DONE\")\nif (KICK_DONE == \"NULL\") or (KICK_DONE == \"FALSE\") then \n\treturn false\nelse \n\tchaos.setGlobal(\"KICK_DONE\",0,\"FALSE\")\n\treturn true\nend"
              }
            ]
          },

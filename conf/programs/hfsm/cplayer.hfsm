                "test": "local ball = chaos.getLpo(chaos.BALL_LPO)\nlocal net1 = chaos.getLpo(chaos.NET1_LPO)\nlocal net2 = chaos.getLpo(chaos.NET2_LPO)\n\nif ball.rho < 800 then\n\tif (net1.anchored > 0.5) and (math.abs(net1.theta) > 91.6732) then \n\t\treturn true\n\tend\n\tif (net2.anchored > 0.5) and (math.abs(net2.theta) < 91.6732) then \n\t\treturn true\n\tend\nend\n\nreturn false"
              },
